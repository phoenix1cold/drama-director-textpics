{
  "id": "drama-director-textpics",
  "title": "Drama Director — Text & Pics",
  "description": "Text and image overlay editor with named presets. Renders cinematic text/image overlays through the cinematic module's effect engine. Part of the Drama Director module family.",
  "version": "1.0",
  "compatibility": {
    "minimum": "13",
    "verified": "14"
  },
  "authors": [
    {
      "name": "phoenix1cold",
      "url": "https://github.com/phoenix1cold"
    }
  ],
  "esmodules": [
    "scripts/main.mjs"
  ],
  "styles": [
    "styles/textpics.css"
  ],
  "socket": false,
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    },
    {
      "lang": "ru",
      "name": "Русский",
      "path": "lang/ru.json"
    },
    {
      "lang": "fr",
      "name": "Français",
      "path": "lang/fr.json"
    },
    {
      "lang": "zh",
      "name": "Chinese Simplified",
      "path": "lang/zh.json"
    }
  ],
  "templates": [
    "templates/textpics-panel.hbs"
  ],
  "relationships": {
    "requires": [
      {
        "id": "drama-director-hub",
        "type": "module",
        "compatibility": {
          "minimum": "1.0"
        }
      }
    ],
    "recommends": [
      {
        "id": "drama-director-cinematic",
        "type": "module",
        "reason": "Provides the actual rendering engine for text and pic overlays."
      }
    ]
  },
  "flags": {},
  "url": "https://github.com/phoenix1cold/drama-director-textpics",
  "manifest": "https://github.com/phoenix1cold/drama-director-textpics/releases/latest/download/module.json",
  "download": "https://github.com/phoenix1cold/drama-director-textpics/releases/download/v1.0/module.zip",
  "readme": "https://github.com/phoenix1cold/drama-director-textpics/blob/main/README.md",
  "bugs": "https://github.com/phoenix1cold/drama-director-textpics/issues"
}